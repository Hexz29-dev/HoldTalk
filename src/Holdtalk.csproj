<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Holdtalk</AssemblyName>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets/HoldTalk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Holdtalk.Tests" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Resource Include="Assets/HoldTalk.ico" />
    <None Include="../config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../.env.example" Link=".env.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
